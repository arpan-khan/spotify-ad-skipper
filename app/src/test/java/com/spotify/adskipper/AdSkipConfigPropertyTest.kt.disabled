package com.spotify.adskipper

import io.kotest.property.Arb
import io.kotest.property.arbitrary.long
import io.kotest.property.arbitrary.string
import io.kotest.property.checkAll
import org.junit.Test
import kotlin.test.assertEquals
import kotlin.test.assertFailsWith
import kotlin.test.assertTrue

/**
 * Property-based tests for AdSkipConfig validation.
 * 
 * **Validates: Property 6 - Timing Consistency**
 * **Requirements: 11.3, 11.4**
 * 
 * Property 6 states: For any configured ad skip timing, the force-stop delay 
 * is between 500ms and 3000ms inclusive, and the skip delay is between 1000ms 
 * and 5000ms inclusive.
 */
class AdSkipConfigPropertyTest {

    /**
     * Property: All valid forceStopDelayMs values (500-3000) create valid configs.
     * **Validates: Requirements 11.3**
     */
    @Test
    fun `property - all forceStopDelayMs values in valid range create valid configs`() {
        checkAll(Arb.long(500L..3000L)) { forceStopDelay ->
            val config = AdSkipConfig(forceStopDelayMs = forceStopDelay)
            
            // Verify the value is stored correctly
            assertEquals(forceStopDelay, config.forceStopDelayMs)
            
            // Verify it's within the valid range
            assertTrue(forceStopDelay in 500L..3000L)
        }
    }

    /**
     * Property: All valid skipDelayMs values (1000-5000) create valid configs.
     * **Validates: Requirements 11.4**
     */
    @Test
    fun `property - all skipDelayMs values in valid range create valid configs`() {
        checkAll(Arb.long(1000L..5000L)) { skipDelay ->
            val config = AdSkipConfig(skipDelayMs = skipDelay)
            
            // Verify the value is stored correctly
            assertEquals(skipDelay, config.skipDelayMs)
            
            // Verify it's within the valid range
            assertTrue(skipDelay in 1000L..5000L)
        }
    }

    /**
     * Property: All forceStopDelayMs values below 500ms are rejected.
     * **Validates: Requirements 11.3**
     */
    @Test
    fun `property - all forceStopDelayMs values below minimum are rejected`() {
        checkAll(Arb.long(Long.MIN_VALUE..499L)) { invalidDelay ->
            assertFailsWith<IllegalArgumentException> {
                AdSkipConfig(forceStopDelayMs = invalidDelay)
            }
        }
    }

    /**
     * Property: All forceStopDelayMs values above 3000ms are rejected.
     * **Validates: Requirements 11.3**
     */
    @Test
    fun `property - all forceStopDelayMs values above maximum are rejected`() {
        checkAll(Arb.long(3001L..10000L)) { invalidDelay ->
            assertFailsWith<IllegalArgumentException> {
                AdSkipConfig(forceStopDelayMs = invalidDelay)
            }
        }
    }

    /**
     * Property: All skipDelayMs values below 1000ms are rejected.
     * **Validates: Requirements 11.4**
     */
    @Test
    fun `property - all skipDelayMs values below minimum are rejected`() {
        checkAll(Arb.long(Long.MIN_VALUE..999L)) { invalidDelay ->
            assertFailsWith<IllegalArgumentException> {
                AdSkipConfig(skipDelayMs = invalidDelay)
            }
        }
    }

    /**
     * Property: All skipDelayMs values above 5000ms are rejected.
     * **Validates: Requirements 11.4**
     */
    @Test
    fun `property - all skipDelayMs values above maximum are rejected`() {
        checkAll(Arb.long(5001L..15000L)) { invalidDelay ->
            assertFailsWith<IllegalArgumentException> {
                AdSkipConfig(skipDelayMs = invalidDelay)
            }
        }
    }

    /**
     * Property: All combinations of valid timing values create valid configs.
     * **Validates: Requirements 11.3, 11.4**
     */
    @Test
    fun `property - all valid timing combinations create valid configs`() {
        checkAll(
            Arb.long(500L..3000L),
            Arb.long(1000L..5000L)
        ) { forceStopDelay, skipDelay ->
            val config = AdSkipConfig(
                forceStopDelayMs = forceStopDelay,
                skipDelayMs = skipDelay
            )
            
            // Verify both values are stored correctly
            assertEquals(forceStopDelay, config.forceStopDelayMs)
            assertEquals(skipDelay, config.skipDelayMs)
            
            // Verify both are within valid ranges
            assertTrue(forceStopDelay in 500L..3000L)
            assertTrue(skipDelay in 1000L..5000L)
        }
    }

    /**
     * Property: Non-blank package names are accepted.
     * **Validates: Requirements 11.1**
     */
    @Test
    fun `property - non-blank package names are accepted`() {
        checkAll(Arb.string(minSize = 1, maxSize = 100)) { packageName ->
            if (packageName.isNotBlank()) {
                val config = AdSkipConfig(spotifyPackageName = packageName)
                assertEquals(packageName, config.spotifyPackageName)
            }
        }
    }

    /**
     * Property: Non-blank ad title keywords are accepted.
     * **Validates: Requirements 11.2**
     */
    @Test
    fun `property - non-blank ad title keywords are accepted`() {
        checkAll(Arb.string(minSize = 1, maxSize = 100)) { keyword ->
            if (keyword.isNotBlank()) {
                val config = AdSkipConfig(adTitleKeyword = keyword)
                assertEquals(keyword, config.adTitleKeyword)
            }
        }
    }

    /**
     * Property: Config creation is idempotent - same inputs always produce same outputs.
     * **Validates: Requirements 11.3, 11.4**
     */
    @Test
    fun `property - config creation is idempotent`() {
        checkAll(
            Arb.long(500L..3000L),
            Arb.long(1000L..5000L)
        ) { forceStopDelay, skipDelay ->
            val config1 = AdSkipConfig(
                forceStopDelayMs = forceStopDelay,
                skipDelayMs = skipDelay
            )
            val config2 = AdSkipConfig(
                forceStopDelayMs = forceStopDelay,
                skipDelayMs = skipDelay
            )
            
            // Same inputs produce equal configs
            assertEquals(config1, config2)
            assertEquals(config1.forceStopDelayMs, config2.forceStopDelayMs)
            assertEquals(config1.skipDelayMs, config2.skipDelayMs)
        }
    }
}
